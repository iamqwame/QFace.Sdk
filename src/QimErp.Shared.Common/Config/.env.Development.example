# QimErp.Shared.Common - Development Environment Variables
# Override base .env.example values for local/dev environments.

FrontendSettings__BaseUrl=https://app-dev.qimerp.com
FrontendSettings__ActivationPath=/auth/activate
FrontendSettings__ResetPasswordPath=/auth/reset-password
FrontendSettings__LoginPath=/auth/login

System__DefaultUserId=system
System__DefaultUserName=System
System__DefaultSystemEmail=system@qimerp.com
System__ConsumerSystemEmail=system@consumer
System__DefaultNextStepName=Final Review
System__DefaultRequesterName=Requester
System__DefaultApproverName=Approver
System__DefaultWorkflowCodeDisplayName=Workflow Request

RabbitMq__NotificationsExchange=qimerp.core.notify.dev_exchange
RabbitMq__WorkflowApprovalRequiredExchange=qimerp.workflow.workflow_approval_required.dev_exchange
RabbitMq__WorkflowChangedExchange=qimerp.workflow.workflow_changed.dev_exchange
RabbitMq__WorkflowStatusChangedExchange=qimerp.workflow.workflow_status_changed.dev_exchange
RabbitMq__WorkflowCompletedExchange=qimerp.workflow.workflow_completed.dev_exchange
