<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <PackageId>QimErp.Shared.DataIntegrity</PackageId>
        <Version>1.0.0</Version>
        <Authors>IAmQwame</Authors>
        <Company>QimErp</Company>
        <Description>
            DATA-06 nightly loose-link integrity checks for QimErp services. Discovers references
            without foreign keys from each DbContext's EF Core model, runs read-only tenant-grouped
            orphan, tenant-mismatch, deleted-target and local-copy version checks from a Temporal
            Schedule, and reports counts and sample row ids through structured logs and metrics.
        </Description>
        <PackageTags>qimerp;data-integrity;efcore;temporal;diagnostics</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/iamqwame/QimErp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/iamqwame/QimErp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591;1573;1574</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
        <!-- Must stay 1.0.10: three service repos pin it directly and a higher floor raises NU1605. -->
        <PackageReference Include="QFace.Sdk.Temporal" Version="1.0.10" />
        <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.9.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)..\..\docs\data-integrity.md" Pack="true" PackagePath="content\docs\" />
    </ItemGroup>

</Project>
